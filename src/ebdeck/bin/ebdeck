#!/usr/bin/env bash
# ebdeck — auto-bootstrapping shell wrapper for the ebdeck Python CLI.
#
# Why a wrapper instead of `pip install -e .`?
#
#   ebdeck is a thin orchestrator over deck-cli/docker-compose.yaml. Unlike
#   the other CLIs in earlbear-clis/ (ebjira/ebdocs/ebshop), it runs on the
#   host and shells out to `docker compose` — running it inside Docker would
#   cause docker-in-docker path-mounting hell. But that doesn't mean the user
#   should have to manage a Python venv by hand.
#
#   This wrapper auto-creates a hidden venv the first time it's invoked,
#   pip-installs ebdeck into it, and then execs the real entry point. After
#   the one-time bootstrap, each invocation just execs the venv's ebdeck —
#   essentially zero overhead.
#
# Usage:
#
#   1. Add deck-cli/bin to your PATH, OR symlink this file into ~/bin or
#      /usr/local/bin. Either works.
#
#   2. Run `ebdeck --help`. First run bootstraps the venv (~10s), subsequent
#      runs are instant.
#
#   3. To force a rebuild of the venv (after editing pyproject.toml, for
#      instance): `rm -rf deck-cli/.venv` and re-run ebdeck.
#
# Environment variables:
#
#   EBDECK_PYTHON   — override the python3 binary used to create the venv
#                     (default: python3 on PATH, must be >=3.11)
#   EBDECK_VENV     — override the venv location (default: <deck-cli>/.venv)

set -euo pipefail

# Resolve the deck-cli directory from the physical location of this script,
# following symlinks so the wrapper works when symlinked into ~/bin or
# /usr/local/bin.
SCRIPT_SRC="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SRC" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SRC")" && pwd)"
  SCRIPT_SRC="$(readlink "$SCRIPT_SRC")"
  [[ "$SCRIPT_SRC" != /* ]] && SCRIPT_SRC="$SCRIPT_DIR/$SCRIPT_SRC"
done
DECK_CLI_DIR="$(cd -P "$(dirname "$SCRIPT_SRC")/.." && pwd)"

VENV="${EBDECK_VENV:-$DECK_CLI_DIR/.venv}"
PYTHON_BIN="${EBDECK_PYTHON:-python3}"

bootstrap() {
  if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    echo "ebdeck: $PYTHON_BIN not found on PATH. Install Python >=3.11 or set EBDECK_PYTHON." >&2
    exit 127
  fi
  echo "ebdeck: bootstrapping venv at $VENV (one-time, ~10s)..." >&2
  "$PYTHON_BIN" -m venv "$VENV" >&2
  # Upgrade pip quietly so editable installs of modern pyproject.toml work
  # reliably on older system Pythons.
  "$VENV/bin/pip" install --quiet --upgrade pip >&2
  "$VENV/bin/pip" install --quiet -e "$DECK_CLI_DIR" >&2
  echo "ebdeck: bootstrap complete." >&2
}

if [ ! -x "$VENV/bin/ebdeck" ]; then
  bootstrap
fi

exec "$VENV/bin/ebdeck" "$@"
